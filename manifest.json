{
  "manifest_version": 3,
  "name": "Jev Tab Switcher",
  "version": "0.1.0",
  "description": "Type a vague phrase like \"board slides\" and jump to the right tab. Uses the Jev decision model to pick the tab.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.aimlapi.com/*",
    "https://*.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Jump to tab (Jev)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options.html",
  "omnibox": {
    "keyword": "t"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the tab switcher"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
